import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class BankFundTransfer {
    private static final String URL = "jdbc:mysql://localhost:3306/bank_db";
    private static final String USER = "root";
    private static final String PASSWORD = "password";

    public static void performTransfer(int senderId, int receiverId, double transferAmount) {
        String withdrawSQL = "UPDATE accounts SET balance = balance - ? WHERE account_id = ?";
        String depositSQL = "UPDATE accounts SET balance = balance + ? WHERE account_id = ?";
        
        Connection connection = null;
        PreparedStatement withdrawStatement = null;
        PreparedStatement depositStatement = null;

        try {
            connection = DriverManager.getConnection(URL, USER, PASSWORD);
            
            // 1. Disable Auto-Commit to turn on custom transaction boundaries
            connection.setAutoCommit(false);

            // 2. Setup Withdrawal
            withdrawStatement = connection.prepareStatement(withdrawSQL);
            withdrawStatement.setDouble(1, transferAmount);
            withdrawStatement.setInt(2, senderId);
            int withdrawRows = withdrawStatement.executeUpdate();

            // 3. Setup Deposit
            depositStatement = connection.prepareStatement(depositSQL);
            depositStatement.setDouble(1, transferAmount);
            depositStatement.setInt(2, receiverId);
            int depositRows = depositStatement.executeUpdate();

            // Verify both operations updated exactly 1 valid record row
            if (withdrawRows == 1 && depositRows == 1) {
                // 4. Commit everything together safely
                connection.commit();
                System.out.println("Transaction complete! Succesfully transferred $" + transferAmount + ".");
            } else {
                throw new SQLException("Invalid transaction criteria matching account identifiers.");
            }

        } catch (SQLException e) {
            System.err.println("Transaction failure detected! Initiating structural rollback logic...");
            if (connection != null) {
                try {
                    // 5. Rollback on operation exception failure to hold atomicity constraints
                    connection.rollback();
                    System.out.println("Rollback completed successfully. Data consistency preserved.");
                } catch (SQLException rollbackException) {
                    rollbackException.printStackTrace();
                }
            }
        } finally {
            // Secure cleanup of active SQL resources
            try {
                if (withdrawStatement != null) withdrawStatement.close();
                if (depositStatement != null) depositStatement.close();
                if (connection != null) connection.close();
            } catch (SQLException cleanupException) {
                cleanupException.printStackTrace();
            }
        }
    }

    public static void main(String[] args) {
        // Example execution: Transfer $1500.00 from Account 1001 to Account 1002
        performTransfer(1001, 1002, 1500.00);
    }
}
