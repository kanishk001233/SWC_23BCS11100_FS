import React, { useState, useEffect } from 'react';

const ProductList = () => {
  const [data, setData] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    const fetchData = async () => {
      try {
        setLoading(true);
        const response = await fetch('https://jsonplaceholder.typicode.com/posts?_limit=5');
        if (!response.ok) throw new Error("Failed to fetch products");
        const result = await response.json();
        setData(result);
      } catch (err) {
        setError(err.message);
      } finally {
        setLoading(false);
      }
    };

    fetchData();
  }, []);

  if (loading) return <div style={centerStyle}>Loading Products...</div>;
  if (error) return <div style={{...centerStyle, color: 'red'}}>Error: {error}</div>;

  return (
    <div style={{ padding: '20px', maxWidth: '600px', margin: 'auto' }}>
      <h2>Amazon Product Listing</h2>
      {data.map(item => (
        <div key={item.id} style={cardStyle}>
          <h4>{item.title}</h4>
          <p>{item.body.substring(0, 100)}...</p>
        </div>
      ))}
    </div>
  );
};

const cardStyle = { border: '1px solid #ddd', padding: '15px', margin: '10px 0', borderRadius: '8px' };
const centerStyle = { textAlign: 'center', marginTop: '50px', fontSize: '20px' };

export default ProductList;
