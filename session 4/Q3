<!DOCTYPE html>
<html>
<head>
    <style>
        .autocomplete { position: relative; width: 300px; margin: 20px; font-family: Arial; }
        input { width: 100%; padding: 10px; box-sizing: border-box; }
        .suggestions { border: 1px solid #ddd; list-style: none; padding: 0; margin: 0; position: absolute; width: 100%; background: white; max-height: 200px; overflow-y: auto; }
        .suggestions li { padding: 10px; cursor: pointer; }
        .suggestions li:hover, .suggestions li.active { background-color: #e9e9e9; color: #007bff; }
    </style>
</head>
<body>
    <div class="autocomplete">
        <input type="text" id="search" placeholder="Type a language (e.g. Java, Python)..." autocomplete="off">
        <ul id="suggestion-list" class="suggestions"></ul>
    </div>

    <script>
        const data = ["JavaScript", "Java", "Python", "C++", "Ruby", "Swift", "PHP", "Go"];
        const input = document.getElementById('search');
        const list = document.getElementById('suggestion-list');
        let activeIndex = -1;

        input.addEventListener('input', (e) => {
            const val = e.target.value.toLowerCase();
            list.innerHTML = '';
            activeIndex = -1;
            if (!val) return;

            const filtered = data.filter(item => item.toLowerCase().includes(val));
            filtered.forEach((item, index) => {
                const li = document.createElement('li');
                li.innerText = item;
                li.onclick = () => selectItem(item);
                list.appendChild(li);
            });
        });

        input.addEventListener('keydown', (e) => {
            const items = list.getElementsByTagName('li');
            if (e.key === "ArrowDown") {
                activeIndex = (activeIndex + 1) % items.length;
                updateActive(items);
            } else if (e.key === "ArrowUp") {
                activeIndex = (activeIndex - 1 + items.length) % items.length;
                updateActive(items);
            } else if (e.key === "Enter" && activeIndex > -1) {
                selectItem(items[activeIndex].innerText);
            }
        });

        function updateActive(items) {
            Array.from(items).forEach((item, i) => {
                item.classList.toggle('active', i === activeIndex);
            });
        }

        function selectItem(val) {
            input.value = val;
            list.innerHTML = '';
        }
    </script>
</body>
</html>
