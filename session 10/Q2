class InsufficientBalanceException extends Exception {
    public InsufficientBalanceException(String message) {
        super(message);
    }
}

class BankAccount {
    private double balance;

    public BankAccount(double initialBalance) {
        this.balance = initialBalance;
    }

    public void withdraw(double amount) throws InsufficientBalanceException {
        System.out.println("Attempting to withdraw: $" + amount);
        try {
            if (amount > balance) {
                throw new InsufficientBalanceException("Error: Insufficient funds. Current balance: $" + balance);
            }
            balance -= amount;
            System.out.println("Withdrawal successful. New balance: $" + balance);
        } catch (InsufficientBalanceException e) {
            // Log transaction attempt failure
            System.err.println("Transaction Log: " + e.getMessage());
            throw e; // Rethrow to notify caller
        } finally {
            System.out.println("Transaction attempt finished.");
        }
    }
}

public class BankingApp {
    public static void main(String[] args) {
        BankAccount account = new BankAccount(500.0);
        try {
            account.withdraw(600.0);
        } catch (InsufficientBalanceException e) {
            System.out.println("Caught in Main: " + e.getMessage());
        }
    }
}
