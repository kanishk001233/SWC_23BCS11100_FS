<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial; padding: 20px; }
        #searchBox { width: 100%; padding: 10px; margin-bottom: 20px; font-size: 16px; }
        .item { padding: 10px; border-bottom: 1px solid #eee; }
    </style>
</head>
<body>
    <input type="text" id="searchBox" placeholder="Search products (e.g., iPhone, Laptop)...">
    <div id="resultsList">
        <div class="item">iPhone 15</div>
        <div class="item">MacBook Air</div>
        <div class="item">Sony Headphones</div>
        <div class="item">Gaming Laptop</div>
        <div class="item">Smart Watch</div>
    </div>

    <script>
        const searchInput = document.getElementById('searchBox');
        const items = document.querySelectorAll('.item');

        // Debounce Function
        function debounce(func, delay) {
            let timeout;
            return function(...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), delay);
            };
        }

        const filterList = debounce((query) => {
            console.log("Searching for:", query); // Verify performance in console
            const lowerQuery = query.toLowerCase();
            
            items.forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = text.includes(lowerQuery) ? 'block' : 'none';
            });
        }, 300);

        searchInput.addEventListener('input', (e) => filterList(e.target.value));
    </script>
</body>
</html>
