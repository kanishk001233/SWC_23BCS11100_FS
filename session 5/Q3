<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial; padding: 20px; }
        #preview { width: 200px; height: 200px; border: 2px dashed #ccc; margin-top: 10px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
        #preview img { max-width: 100%; max-height: 100%; }
        .error { color: red; margin-top: 5px; font-size: 14px; }
    </style>
</head>
<body>
    <h3>Upload Profile Photo</h3>
    <input type="file" id="imageInput" accept="image/*" onchange="handleImage(event)">
    <div id="errorMsg" class="error"></div>
    <div id="preview">No Image Selected</div>

    <script>
        function handleImage(e) {
            const file = e.target.files[0];
            const errorMsg = document.getElementById('errorMsg');
            const preview = document.getElementById('preview');
            errorMsg.innerText = '';
            preview.innerHTML = '';

            if (!file) return;

            // Validation: File Type
            if (!file.type.startsWith('image/')) {
                errorMsg.innerText = "Please select a valid image file.";
                return;
            }

            // Validation: File Size (2MB = 2 * 1024 * 1024 bytes)
            if (file.size > 2 * 1024 * 1024) {
                errorMsg.innerText = "File size exceeds 2MB limit.";
                return;
            }

            // Preview logic
            const reader = new FileReader();
            reader.onload = function(event) {
                const img = document.createElement('img');
                img.src = event.target.result;
                preview.appendChild(img);
            };
            reader.readAsDataURL(file);
        }
    </script>
</body>
</html>
