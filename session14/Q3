import java.util.ArrayList;
import java.util.List;

public class StreamComparison {
    public static void main(String[] args) {
        List<Integer> numbers = new ArrayList<>();
        for (int i = 0; i < 10_000_000; i++) {
            numbers.add(i);
        }

        long startTime = System.nanoTime();
        long countSequential = numbers.stream()
                .filter(n -> n % 2 == 0)
                .map(n -> Math.sqrt(n))
                .count();
        long endTime = System.nanoTime();
        long sequentialDuration = endTime - startTime;

        startTime = System.nanoTime();
        long countParallel = numbers.parallelStream()
                .filter(n -> n % 2 == 0)
                .map(n -> Math.sqrt(n))
                .count();
        endTime = System.nanoTime();
        long parallelDuration = endTime - startTime;

        System.out.println("Sequential Stream Time: " + (sequentialDuration / 1_000_000.0) + " ms");
        System.out.println("Parallel Stream Time: " + (parallelDuration / 1_000_000.0) + " ms");
        System.out.println("Sequential Count: " + countSequential);
        System.out.println("Parallel Count: " + countParallel);
    }
}
